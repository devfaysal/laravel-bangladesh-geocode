{
    "name": "devfaysal/laravel-bangladesh-geocode",
    "description": "Bangladesh divisions, districts, upazilas, unions and postal data for Laravel address forms and cascading location dropdowns.",
    "keywords": [
        "laravel",
        "bangladesh",
        "bangladesh-geocode",
        "division",
        "district",
        "upazila",
        "union",
        "pourashava",
        "post-office",
        "postal-code",
        "address",
        "dropdown",
        "devfaysal"
    ],
    "homepage": "https://github.com/devfaysal/laravel-bangladesh-geocode",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Faysal Ahamed",
            "email": "devfaysal@gmail.com",
            "role": "Developer"
        }
    ],
    "support": {
        "docs": "https://github.com/devfaysal/laravel-bangladesh-geocode#readme",
        "issues": "https://github.com/devfaysal/laravel-bangladesh-geocode/issues",
        "source": "https://github.com/devfaysal/laravel-bangladesh-geocode"
    },
    "require": {
        "php": "^8.2",
        "illuminate/console": "^12.69|^13.30",
        "illuminate/database": "^12.69|^13.30",
        "illuminate/support": "^12.69|^13.30"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.3"
    },
    "autoload": {
        "psr-4": {
            "Devfaysal\\BangladeshGeocode\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Devfaysal\\BangladeshGeocode\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
        "lint": "vendor/bin/pint --test",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Devfaysal\\BangladeshGeocode\\BangladeshGeocodeServiceProvider"
            ],
            "aliases": {
                "BangladeshGeocode": "Devfaysal\\BangladeshGeocode\\BangladeshGeocodeFacade"
            }
        }
    }
}
